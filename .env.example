# Copia este archivo a .env para inyectar las credenciales de Aurora desde
# fuera de la imagen. docker compose lo lee automáticamente y .env está
# excluido de Git, así que las credenciales no se versionan.
#
# Si no creas el .env, el backend usa los valores de application.properties.
# Se emplean los nombres de propiedad de Spring Boot directamente: las
# variables de entorno tienen prioridad sobre el archivo de propiedades.

SPRING_DATASOURCE_URL=jdbc:postgresql://<host-aurora>:5432/<base>
SPRING_DATASOURCE_USERNAME=<usuario>
SPRING_DATASOURCE_PASSWORD=<contraseña>
